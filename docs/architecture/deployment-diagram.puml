@startuml deployment-diagram
' Sơ đồ triển khai (UML deployment diagram) môi trường production BrewLite – Task 3.2
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam roundCorner 10
left to right direction
skinparam nodesep 45
skinparam ranksep 90
skinparam ArrowColor #5A4632
skinparam ArrowFontSize 12
skinparam node {
  BackgroundColor #FFF8F0
  BorderColor #6F4E37
  FontStyle bold
}
skinparam artifact {
  BackgroundColor #FFFFFF
  BorderColor #8A7560
  FontStyle normal
}
skinparam database {
  BackgroundColor #F3E3CC
  BorderColor #6F4E37
}
skinparam legend {
  BackgroundColor #FFFDF9
  BorderColor #B9A38A
  FontSize 12
}
skinparam rectangle {
  BorderColor #9C9C9C
  BorderStyle dashed
  FontColor #555555
  FontStyle bold
}

title Sơ đồ triển khai BrewLite – môi trường production

node "Điện thoại / máy tính\n<<device>>" as Device {
  artifact "Trình duyệt chạy BrewLite PWA" as PWA
}

rectangle "Production" {
  node "Vercel – CDN\n<<platform>>" as Vercel {
    artifact "Web Next.js\nbrewlite-nhom10.vercel.app" as Web
  }
  node "Render – Singapore\n<<platform>>" as Render {
    node "Web Service brewlite-api\n<<container>>" as Api {
      artifact "Image brewlite-api:<commit-sha>\nNestJS · cổng 10000 · /health" as ApiImg
    }
    database "PostgreSQL 16\n<<persistent storage>>" as PG
  }
  node "VNPay sandbox\n<<external>>" as VNPay
}

rectangle "CI/CD – GitHub" {
  node "GitHub Actions\n<<runner>>" as Runner {
    artifact "ci.yml · cd.yml" as Workflows
  }
  node "GitHub Container Registry\n<<registry>>" as GHCR
}

rectangle "Local – máy phát triển" {
  node "Docker Compose\n<<execution environment>>" as Compose {
    artifact "web :3000 · api :3001\npostgres 127.0.0.1:5433" as LocalStack
  }
}

' Người dùng
Device --> Web : HTTPS 443
Device --> Api : HTTPS 443 · REST + JWT
Device ..> VNPay : HTTPS 443 · nhập thẻ

' Bên trong production
Api --> PG : mạng nội bộ · TCP 5432
VNPay --> Api : HTTPS · IPN
Api --> VNPay : HTTPS · querydr

' Triển khai
Runner --> GHCR : push image
GHCR ..> Api : pull image
Runner --> Render : Render API · deploy
Runner --> Vercel : Vercel CLI · deploy

legend right
  <b>Secret, cấu hình</b>
  GitHub Secrets: token Render, Vercel
  Render: DATABASE_URL, JWT_SECRET, VNP_*
  Vercel: NEXT_PUBLIC_API_URL
  <b>Health check, log</b>
  Render gọi /health; smoke test sau deploy
  Log: Render Logs, Vercel Deployments
  <b>CSDL</b>: chặn mọi IP từ Internet
endlegend
@enduml
