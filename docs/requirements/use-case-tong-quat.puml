@startuml use-case-tong-quat
' Sơ đồ use-case tổng quát BrewLite
left to right direction
skinparam packageStyle rectangle
skinparam shadowing false
skinparam defaultFontName Arial
skinparam usecase {
  BackgroundColor #FFF8F0
  BorderColor #6F4E37
}
skinparam actorBorderColor #6F4E37

actor "Khách vãng lai" as Guest
actor "Khách hàng" as Customer
actor "Nhân viên quầy" as Staff
actor "Quản lý" as Manager
actor "Cổng VNPay" as VNPay <<hệ thống ngoài>>
actor "Bộ hẹn giờ" as Timer <<hệ thống>>

Customer -|> Guest

rectangle "BrewLite" {
  usecase "UC-02 Xem menu và tìm món" as UC02
  usecase "UC-03 Xem chi tiết và tuỳ chọn món" as UC03
  usecase "UC-04 Quản lý giỏ hàng" as UC04
  usecase "UC-05 Đăng ký tài khoản" as UC05
  usecase "UC-06 Đăng nhập" as UC06
  usecase "UC-12 Gửi phản hồi" as UC12

  usecase "UC-01 Đặt và thanh toán đơn hàng" as UC01 #F3D9B1
  usecase "UC-07 Theo dõi đơn, lịch sử đơn" as UC07
  usecase "UC-08 Huỷ đơn chưa thanh toán" as UC08
  usecase "UC-09 Lịch sử giao dịch, đối soát" as UC09
  usecase "UC-10 Đổi điểm lấy quà" as UC10
  usecase "UC-11 Hồ sơ, món yêu thích, đổi mật khẩu" as UC11

  usecase "UC-13 Xử lý hàng đợi pha chế" as UC13
  usecase "UC-14 Huỷ đơn đã thanh toán" as UC14

  usecase "UC-15 Xem tổng quan doanh thu" as UC15
  usecase "UC-16 Quản lý thực đơn" as UC16
  usecase "UC-17 Quản lý mã giảm giá" as UC17
  usecase "UC-18 Quản lý tài khoản khách" as UC18
  usecase "UC-19 Xử lý phản hồi, nội dung trang" as UC19
  usecase "UC-20 Quản lý kho nguyên liệu" as UC20

  usecase "UC-21 Tự huỷ đơn bỏ dở" as UC21
}

Guest --> UC02
Guest --> UC03
Guest --> UC04
Guest --> UC05
Guest --> UC06
Guest --> UC12

Customer --> UC01
Customer --> UC07
Customer --> UC08
Customer --> UC09
Customer --> UC10
Customer --> UC11

Staff --> UC06
Staff --> UC13
Staff --> UC14

Manager --> UC06
Manager --> UC15
Manager --> UC16
Manager --> UC17
Manager --> UC18
Manager --> UC19
Manager --> UC20

UC01 --> VNPay
UC09 --> VNPay
Timer --> UC21

UC03 .> UC02 : <<extend>>
UC04 .> UC01 : <<extend>>\nđặt từ giỏ
@enduml
